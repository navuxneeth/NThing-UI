[Variables]
; ==========================================
; NThing UI - Global Settings
; ==========================================
; This file contains global settings for all widgets
; Edit these values to customize colors and scale
; ==========================================

; ==========================================
; SCALE / RESOLUTION SETTINGS
; ==========================================
; Adjust this value to scale all widgets
; 1 = 100%, 1.5 = 150%, 0.75 = 75%, etc.
GlobalScale=1

; ==========================================
; COLOR SETTINGS - LIGHT THEME
; ==========================================
; Background color for light theme widgets
LightBgColor=F1F0F6

; Primary text color for light theme
LightTextColor=1B1C1D

; Secondary/subtle text or background color for light theme
LightSecondaryColor=D4D3D8

; Widget container color for light theme
LightContainerColor=FFFFFF

; ==========================================
; COLOR SETTINGS - DARK THEME
; ==========================================
; Background color for dark theme widgets
DarkBgColor=1B1C1D

; Primary text color for dark theme
DarkTextColor=F1F0F6

; Secondary/subtle text or background color for dark theme
DarkSecondaryColor=3A3A3D

; Widget container color for dark theme
DarkContainerColor=2A2A2D

; ==========================================
; ACCENT COLOR
; ==========================================
; Primary accent color (NothingOS Red)
AccentColor=E2201F

; ==========================================
; CHART/PROGRESS BAR COLORS
; ==========================================
; Color for RAM usage indicator
RAMColor=255,0,0,255

; Color for CPU usage indicator
CPUColor=0,120,255,255

; Color for Storage/HDD usage indicator
StorageColor=0,200,120,255
